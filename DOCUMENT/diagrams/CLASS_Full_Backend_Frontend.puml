@startuml
!theme vibrant
title StreamHub - Complete Class Diagram (Backend + Frontend)
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

' ===========================================================================
' =====================  BACKEND (Java Spring Boot)  =========================
' ===========================================================================

package "Entities" {
  abstract class BaseEntity {
    #createdAt : Instant
    #updatedAt : Instant
  }
  class User {
    -id : UUID
    -email : String
    -name : String
    -password : String
    -enable : boolean
    -provider : Provider
    -providerId : String
    -roles : Set<Role>
    -videos : List<Video>
    +getAuthorities()
    +getUsername()
  }
  class Role {
    -id : UUID
    -name : String
  }
  class Video {
    -videoId : String
    -title : String
    -description : String
    -contentType : String
    -category : String
    -filePath : String
    -viewCount : long
    -user : User
  }
  class Category {
    -id : String
    -name : String
    -slug : String
    -description : String
  }
  class Comment {
    -id : String
    -text : String
    -user : User
    -video : Video
    -parentComment : Comment
    -replies : List<Comment>
  }
  class Feedback {
    -id : String
    -message : String
    -user : User
  }
  class RefreshToken {
    -id : UUID
    -jti : String
    -user : User
    -expiresAt : Instant
    -revoked : boolean
    -replacedByToken : String
  }
  class VideoView {
    -id : Long
    -video : Video
    -user : User
    -viewerIp : String
    -viewedAt : Instant
  }
}

package "Repositories" {
  interface UserRepository
  interface VideoRepository
  interface CommentRepository
  interface CategoryRepository
  interface FeedbackRepository
  interface RoleRepository
  interface RefreshTokenRepository
  interface VideoViewRepository
}

package "Services" {
  interface AuthService <<interface>> {
    +registerUser(userDto) : UserDto
  }
  interface UserService <<interface>> {
    +createUser() : UserDto
    +createPendingUser() : UserDto
    +getAllUsers() : Iterable<UserDto>
    +getUserByEmail() : UserDto
    +getUserById() : UserDto
    +updateUser() : UserDto
    +deleteUser()
  }
  interface VideoService <<interface>> {
    +save(video, file) : VideoDto
    +get(videoId) : VideoDto
    +getAll() : ScrollResponse<VideoDto>
    +processVideo(videoId) : String
    +update() : VideoDto
    +delete(videoId)
    +incrementView()
    +getVideosByUserEmail() : List
  }
  interface AdminService <<interface>> {
    +getDashboardStats() : AdminDashboardDto
    +getAllUsers() : List
    +deleteUser()
    +deleteVideo()
    +assignAdminRole()
    +removeAdminRole()
    +getCategoryStats() : List
  }
  interface CommentService <<interface>> {
    +addComment() : CommentDto
    +getCommentsByVideo() : List
    +deleteComment() : boolean
    +getAllComments() : List
    +adminDeleteComment()
  }
  interface CategoryService <<interface>> {
    +getAllCategories() : List
    +createCategory() : CategoryDto
    +deleteCategory() : Map
  }
  interface FeedbackService <<interface>> {
    +submitFeedback() : FeedbackDto
    +getAllFeedbacks() : List
    +deleteFeedback()
  }
  interface MailService <<interface>> {
    +sendOtpEmail(to, name, otp)
  }
  class AuthServiceImpl
  class UserServiceImpl
  class VideoServiceImpl
  class AdminServiceImpl
  class CommentServiceImpl
  class CategoryServiceImpl
  class FeedbackServiceImpl
  class MailServiceImpl
  class OtpService {
    +generateAndStore(email) : String
    +verify(email, otp) : boolean
    +canResend(email) : boolean
    +clear(email)
  }
}

package "Controllers" {
  class AuthController {
    +login() : TokenResponse
    +refreshToken() : TokenResponse
    +logout()
    +registerUser() : UserDto
    +verifyOtp() : Map
    +resendOtp() : Map
    +getCurrentUser() : UserDto
    +adminLogin() : TokenResponse
    +adminLogout()
  }
  class VideoController {
    +create(file, title...) : ResponseEntity
    +incrementView() : ResponseEntity
    +getAll() : ScrollResponse<VideoDto>
    +getSingleVideo() : VideoDto
    +stream() : Resource
    +streamVideoRange() : Resource
    +serverMasterFile() : Resource
    +serveResolutionPlaylist() : Resource
    +serveSegments() : Resource
    +updateVideo() : ResponseEntity
    +deleteVideo() : ResponseEntity
    +getMyVideos() : ResponseEntity
    +getChannel() : ResponseEntity
  }
  class UserController {
    +createUser() : UserDto
    +getAllUsers() : Iterable
    +getUserByEmail() : UserDto
    +deleteUser() : ResponseEntity
    +updateUser() : UserDto
    +getUserByID() : UserDto
  }
  class AdminController {
    +getDashboardStats() : AdminDashboardDto
    +getAllUsers() : List
    +deleteUser() : Map
    +deleteVideo() : Map
    +assignAdminRole() : Map
    +removeAdminRole() : Map
    +getAllComments() : List
    +deleteComment() : Map
  }
  class CommentController {
    +addComment() : ResponseEntity
    +getComments() : List
    +deleteComment() : ResponseEntity
  }
  class CategoryController {
    +getAllCategories() : List
  }
  class FeedbackController {
    +submitFeedback() : FeedbackDto
    +getAllFeedbacks() : List
    +deleteFeedback() : Map
  }
}

package "Security" {
  class JwtService {
    +generateAccessToken() : String
    +generateRefreshToken() : String
    +parse() : Jws<Claims>
    +isAccessToken() : boolean
    +isRefreshToken() : boolean
    +getUserId() : UUID
    +validateToken() : boolean
  }
  class JwtAuthenticationFilter {
    +doFilterInternal()
    +shouldNotFilter()
  }
  class CustomUserDetailsService {
    +loadUserByUsername() : UserDetails
  }
  class CookieService {
    +attachRefreshCookie()
    +clearRefreshCookie()
    +attachAdminRefreshCookie()
    +clearAdminRefreshCookie()
    +addNoStoreHeaders()
  }
  class SecurityConfig
}

package "Cache" {
  class JwtBlacklistService {
    +blacklistToken() 
    +isTokenBlacklisted() : boolean
  }
  class UserCacheService {
    +getCachedUser() : User
    +cacheUser()
    +evictUserCache()
  }
  class VideoCacheService {
    +getCachedVideo()
    +cacheVideo()
  }
}

package "Config" {
  class ProjectConfig
  class APIDocConfig
  class AppConstants
  class RedisConfig
}

package "Exceptions" {
  class GlobalExceptionHandler
  class ResourceNotFoundException
  class BadRequestException
  class DuplicateResourceException
  class VideoProcessingException
  class ApiError
}

package "DTOs / Helper" {
  class UserDto
  class VideoDto
  class CommentDto
  class TokenResponse
  class LoginRequest
  class ScrollResponse
  class AdminDashboardDto
  class CategoryDto
  class FeedbackDto
  class UserHelper
  class ScrollPositionCodec
}

' ===========================================================================
' =====================  FRONTEND (React + TypeScript)  =====================
' ===========================================================================

package "FE Config" {
  class ApiClient <<axios>> {
    -baseURL
    -interceptors.request
    -interceptors.response
  }
}

package "FE Stores (Zustand)" {
  class AuthStore {
    +accessToken
    +user
    +authStatus
    +login(data)
    +logout()
    +changeLocalLoginData()
    +checkLogin()
  }
  class AdminStore {
    +adminToken
    +adminUser
    +adminStatus
    +adminLogin(email, password)
    +adminLogout()
  }
}

package "FE Services" {
  class AuthService {
    +registerUser()
    +verifyOtp()
    +resendOtp()
    +loginUser()
    +logoutUser()
    +getCurrentUser()
    +verifySession()
    +refreshToken()
    +updateUserProfile()
    +adminLoginApi()
    +adminRefreshToken()
    +adminLogoutApi()
  }
  class VideoService {
    +uploadVideo()
    +getMyVideos()
    +getAllVideos()
    +deleteVideo()
    +updateVideo()
    +getHlsMasterUrl()
    +incrementView()
    +getChannel()
  }
  class AdminService {
    +getDashboardStats()
    +getAllUsers()
    +getUserById()
    +makeAdmin()
    +removeAdmin()
    +deleteUser()
    +getAllVideosAdmin()
    +deleteVideoAdmin()
    +getCategoryStats()
  }
  class CategoryService {
    +getAllCategories()
    +createCategory()
    +deleteCategory()
  }
  class CommentService {
    +getComments()
    +postComment()
    +deleteComment()
    +getAllCommentsAdmin()
    +deleteCommentAdmin()
  }
  class FeedbackService {
    +submitFeedback()
    +getAllFeedbacks()
    +deleteFeedbackAdmin()
  }
}

package "FE Models" {
  class UserModel
  class VideoModel
  class CategoryModel
  class CommentModel
  class ScrollResponseModel
  class LoginDataModel
  class RegisterDataModel
}

package "FE Components" {
  class Navbar
  class Sidebar
  class AdminLayout
  class UserLayout
  class RootLayout
  class LogoutConfirmModal
  class Oauth2Buttons
  class AuthBackground
  class OtpModal
  class VideoCard
  class VideoPlayer
  class VideoUpload
  class EditVideoModal
  class CommentSection
}

package "FE Pages" {
  class LoginPage
  class RegistrationPage
  class EmailVerificationPage
  class HomePage
  class WatchVideoPage
  class UserChannelPage
  class RootLayoutPage
  class OAuthFailurePage
  class OAuthSuccessPage
  class UserHomePage
  class UserProfilePage
  class UploadPage
  class UserFeedbackPage
  class AdminLoginPage
  class AdminDashboardPage
  class AdminUsersPage
  class AdminVideosPage
  class AdminCommentsPage
  class AdminCategoriesPage
  class AdminFeedbackPage
}

' ===========================================================================
' ============================  RELATIONSHIPS  ==============================
' ===========================================================================

' ---- Entity inheritance ----
BaseEntity <|-- User
BaseEntity <|-- Video
BaseEntity <|-- Category
BaseEntity <|-- Comment
BaseEntity <|-- Feedback
BaseEntity <|-- RefreshToken

' ---- Service impl -> interface ----
AuthServiceImpl ..|> AuthService
UserServiceImpl ..|> UserService
VideoServiceImpl ..|> VideoService
AdminServiceImpl ..|> AdminService
CommentServiceImpl ..|> CommentService
CategoryServiceImpl ..|> CategoryService
FeedbackServiceImpl ..|> FeedbackService
MailServiceImpl ..|> MailService

' ---- Repository inheritance ----
UserRepository ..|> JpaRepository
VideoRepository ..|> JpaRepository
CommentRepository ..|> JpaRepository
CategoryRepository ..|> JpaRepository
FeedbackRepository ..|> JpaRepository
RoleRepository ..|> JpaRepository
RefreshTokenRepository ..|> JpaRepository
VideoViewRepository ..|> JpaRepository

' ---- Service -> Repository ----
UserServiceImpl --> UserRepository
UserServiceImpl --> RoleRepository
VideoServiceImpl --> VideoRepository
CommentServiceImpl --> CommentRepository
FeedbackServiceImpl --> FeedbackRepository
AdminServiceImpl --> UserRepository
AdminServiceImpl --> VideoRepository
AdminServiceImpl --> RoleRepository
AuthServiceImpl --> UserRepository
AuthServiceImpl --> RoleRepository
OtpService --> RedisConfig

' ---- Controller -> Service ----
AuthController --> AuthService
AuthController --> JwtService
AuthController --> OtpService
AuthController --> CookieService
AuthController --> MailService
UserController --> UserService
VideoController --> VideoService
AdminController --> AdminService
AdminController --> CommentService
CommentController --> CommentService
CategoryController --> CategoryService
FeedbackController --> FeedbackService

' ---- Security ----
JwtAuthenticationFilter --> JwtService
JwtAuthenticationFilter --> UserRepository
JwtAuthenticationFilter --> JwtBlacklistService
JwtAuthenticationFilter --> UserCacheService
CustomUserDetailsService --> UserRepository
User ..|> UserDetails
JwtAuthenticationFilter --|> OncePerRequestFilter

' ---- Entity relationships ----
User "1" --> "0..*" Video : uploads
User "1" --> "0..*" Comment : writes
User "1" --> "0..*" Feedback : submits
User "1" --> "0..*" RefreshToken : owns
User "*" --> "*" Role : has
Video "1" --> "0..*" Comment : contains
Video "1" --> "0..*" VideoView : receives
Comment "0..1" --> "0..*" Comment : replies

' ---- FRONTEND relationships ----
AuthService ..> ApiClient
VideoService ..> ApiClient
AdminService ..> ApiClient
CategoryService ..> ApiClient
CommentService ..> ApiClient
FeedbackService ..> ApiClient
AuthStore ..> AuthService
AdminStore ..> AuthService
ApiClient ..> AuthStore
ApiClient ..> AdminStore
VideoService ..> VideoModel
VideoService ..> ScrollResponseModel
CategoryService ..> CategoryModel
CommentService ..> CommentModel
AuthService ..> UserModel
AuthService ..> LoginDataModel
AuthService ..> RegisterDataModel
Navbar ..> AuthStore
Sidebar ..> AdminStore
VideoCard ..> VideoService
VideoPlayer ..> VideoService
VideoUpload ..> VideoService
EditVideoModal ..> VideoService
CommentSection ..> CommentService
AdminDashboardPage ..> AdminService
AdminUsersPage ..> AdminService
AdminVideosPage ..> AdminService
AdminCommentsPage ..> AdminService
AdminCategoriesPage ..> CategoryService
AdminFeedbackPage ..> AdminService
LoginPage --> AuthService
RegistrationPage --> AuthService
UploadPage --> VideoService
WatchVideoPage --> VideoService
UserChannelPage --> VideoService
AdminLoginPage --> AuthService
OtpModal --> AuthService

' ---- Frontend <-> Backend (calls via REST API) ----
AuthService ..> AuthController : REST API
AuthService ..> UserController : REST API
VideoService ..> VideoController : REST API
AdminService ..> AdminController : REST API
CommentService ..> CommentController : REST API
CategoryService ..> CategoryController : REST API
FeedbackService ..> FeedbackController : REST API

@enduml