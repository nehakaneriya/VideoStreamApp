@startuml
!theme vibrant
title StreamHub - Combined Collaboration Diagram

left to right direction

actor "User" as U
actor "Viewer" as V
actor "Uploader" as UP
actor "Admin" as A

rectangle "Frontend\n(React)" as FE
rectangle "AuthPage" as AFP
rectangle "VideoPages" as VFP
rectangle "AdminPanel" as AFP2

rectangle "AuthController" as AC
rectangle "AuthService" as AS
rectangle "OtpService" as O
rectangle "JwtService" as J
rectangle "MailService" as M

rectangle "VideoController" as VC
rectangle "VideoService" as VS

rectangle "AdminController" as ADC
rectangle "AdminService" as ADS
rectangle "UserService" as US
rectangle "CommentService" as CS
rectangle "FeedbackService" as FS
rectangle "CategoryService" as CATS

rectangle "FFmpeg" as F
folder "FileSystem\nvideos_hls" as ST
database "Redis" as R
database "MySQL" as DB
rectangle "OAuth Provider" as OAuth

' --- AUTHENTICATION ---
U --> AFP : 1. login/register
AFP --> AC : 2. auth request
AC --> AS : 3. authenticate
AS --> O : 4. verify OTP
AS --> M : 5. send OTP
AS --> J : 6. generate JWT
AS --> R : 7. store token/OTP
AS --> DB : 8. save/verify user

' --- VIDEO ---
UP --> FE : 9. upload video
FE --> VC : 10. upload()
VC --> VS : 11. storeVideo()
VS --> DB : 12. saveMetadata()
VS --> ST : 13. saveOriginal()
VS --> F : 14. transcode()
F --> ST : 15. write HLS

V --> FE : 16. open video
FE --> VC : 17. request playlist
VC --> VS : 18. getPlaylist()
VS --> ST : 19. read HLS
FE --> VC : 20. request segment
VC --> VS : 21. streamSegment()
VS --> ST : 22. read segment

' --- ADMIN ---
A --> FE : 23. open dashboard
FE --> ADC : 24. admin request
ADC --> ADS : 25. manage module
ADS --> US : 26. manage users
ADS --> VC : 27. manage videos
ADS --> CS : 28. manage comments
ADS --> FS : 29. manage feedback
ADS --> CATS : 30. manage categories
ADS --> DB : 31. update database
ADS --> ST : 32. remove video files

@enduml